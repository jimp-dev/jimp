# Check out text files with LF on every platform, so snapshots, fixtures
# (like the .fnt fonts) and formatting are the same on Windows.
* text=auto eol=lf

# Image and color profile fixtures
*.bmp binary
*.gif binary
*.icc binary
*.ico binary
*.j2k binary
*.jp2 binary
*.jpeg binary
*.jpg binary
*.png binary
*.tif binary
*.tiff binary
*.webp binary
*.avif binary
*.wasm binary

# Codec conformance corpora are stored in Git LFS so they don't bloat clones.
# CI pulls them with ./.github/actions/lfs-pull. Locally, install git-lfs
# (https://git-lfs.com) before cloning, or run `git lfs pull` afterwards.
packages/pngjs/test/**/*.png filter=lfs diff=lfs merge=lfs -text
packages/pngjs/test/**/*.gz filter=lfs diff=lfs merge=lfs -text
packages/jpeg-js/test/**/*.jpg filter=lfs diff=lfs merge=lfs -text
packages/jpeg-js/test/**/*.png filter=lfs diff=lfs merge=lfs -text
packages/jpeg-js/test/**/*.ppm filter=lfs diff=lfs merge=lfs -text
packages/jpeg-js/test/**/*.gz filter=lfs diff=lfs merge=lfs -text
plugins/js-gif/test/corpus/**/*.gif filter=lfs diff=lfs merge=lfs -text
plugins/js-gif/test/corpus/**/*.png filter=lfs diff=lfs merge=lfs -text
