{
  "name": "jimp-monorepo",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "description": "The jimp monorepo.",
  "repository": "jimp-dev/jimp",
  "engines": {
    "node": ">=22"
  },
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "scripts": {
    "build": "turbo run build --filter=!@jimp/docs && node scripts/check-browser-bundle.mjs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test -- --watch=false --testTimeout=20000",
    "test:browser": "turbo run test:browser -- --watch=false",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "release": "pnpm build && auto shipit",
    "generate-package": "turbo gen package",
    "generate-plugin": "turbo gen plugin",
    "check-updates": "ncu --packageFile '{,*/**/}package.json'"
  },
  "devDependencies": {
    "@auto-it/all-contributors": "^11.2.1",
    "@auto-it/first-time-contributor": "^11.2.1",
    "@auto-it/released": "^11.2.1",
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@jimp/config-eslint": "workspace:*",
    "@jimp/config-typescript": "workspace:*",
    "@turbo/gen": "^2.11.13",
    "auto": "^11.2.1",
    "npm-check-updates": "^17.1.1",
    "prettier": "^3.3.3",
    "turbo": "^2.11.13"
  }
}
