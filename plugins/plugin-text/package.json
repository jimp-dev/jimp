{
  "name": "@jimp/plugin-text",
  "version": "1.7.0",
  "repository": "jimp-dev/jimp",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "test:browser": "vitest --config vitest.config.browser.mjs",
    "build": "tshy",
    "dev": "tshy --watch",
    "clean": "rimraf node_modules .tshy .tshy-build dist .turbo"
  },
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jimp/core": "workspace:*",
    "@jimp/plugin-draw": "workspace:*",
    "@jimp/types": "workspace:*",
    "opentype.js": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jimp/config-eslint": "workspace:*",
    "@jimp/config-typescript": "workspace:*",
    "@jimp/config-vitest": "workspace:*",
    "@jimp/js-png": "workspace:*",
    "@jimp/test-utils": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/browser": "^4.1.12",
    "eslint": "^9.9.1",
    "tshy": "^3.0.2",
    "typescript": "^5.5.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.12"
  },
  "tshy": {
    "exclude": [
      "**/*.test.ts"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts",
      "./load-ttf": "./src/load-ttf.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./load-ttf": {
      "import": {
        "types": "./dist/esm/load-ttf.d.ts",
        "default": "./dist/esm/load-ttf.js"
      },
      "require": {
        "types": "./dist/commonjs/load-ttf.d.ts",
        "default": "./dist/commonjs/load-ttf.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "typesVersions": {
    "*": {
      "load-ttf": [
        "./dist/commonjs/load-ttf.d.ts"
      ]
    }
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "module": "./dist/esm/index.js"
}
