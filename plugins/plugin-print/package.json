{
  "name": "@jimp/plugin-print",
  "version": "2.2.1",
  "files": [
    "dist"
  ],
  "repository": "jimp-dev/jimp",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "test:browser": "vitest --config vitest.config.browser.mjs",
    "build": "tshy && node scripts/copy-fonts.mjs",
    "dev": "tshy --watch",
    "clean": "rimraf node_modules .tshy .tshy-build dist .turbo"
  },
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@jimp/config-eslint": "workspace:*",
    "@jimp/config-typescript": "workspace:*",
    "@jimp/config-vitest": "workspace:*",
    "@jimp/js-png": "workspace:*",
    "@jimp/test-utils": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/browser": "^5.1.1",
    "eslint": "^10.15.0",
    "tshy": "~4.0.0",
    "typescript": "^7.0.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.1.1"
  },
  "tshy": {
    "exclude": [
      "**/*.test.ts"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts",
      "./load-font": "./src/load-font.ts",
      "./fonts": "./src/fonts.ts",
      "./load-ttf": "./src/load-ttf.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./load-font": {
      "import": {
        "types": "./dist/esm/load-font.d.ts",
        "default": "./dist/esm/load-font.js"
      },
      "require": {
        "types": "./dist/commonjs/load-font.d.ts",
        "default": "./dist/commonjs/load-font.js"
      }
    },
    "./fonts": {
      "import": {
        "types": "./dist/esm/fonts.d.ts",
        "default": "./dist/esm/fonts.js"
      },
      "require": {
        "types": "./dist/commonjs/fonts.d.ts",
        "default": "./dist/commonjs/fonts.js"
      }
    },
    "./load-ttf": {
      "import": {
        "types": "./dist/esm/load-ttf.d.ts",
        "default": "./dist/esm/load-ttf.js"
      },
      "require": {
        "types": "./dist/commonjs/load-ttf.d.ts",
        "default": "./dist/commonjs/load-ttf.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "typesVersions": {
    "*": {
      "load-font": [
        "./dist/commonjs/load-font.d.ts"
      ],
      "fonts": [
        "./dist/commonjs/fonts.d.ts"
      ],
      "load-ttf": [
        "./dist/commonjs/load-ttf.d.ts"
      ]
    }
  },
  "type": "module",
  "dependencies": {
    "@jimp/core": "workspace:*",
    "@jimp/js-jpeg": "workspace:*",
    "@jimp/js-png": "workspace:*",
    "@jimp/plugin-blit": "workspace:*",
    "@jimp/plugin-draw": "workspace:*",
    "@jimp/types": "workspace:*",
    "buffer": "^6.0.3",
    "opentype.js": "^2.0.0",
    "parse-bmfont-ascii": "^1.0.6",
    "parse-bmfont-binary": "^1.0.6",
    "parse-bmfont-xml": "^1.1.6",
    "simple-xml-to-json": "^1.2.7",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/esm/index.js"
}
