{
  "name": "@jimp/wasm-png",
  "version": "2.1.0",
  "files": [
    "dist"
  ],
  "repository": "jimp-dev/jimp",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "test:browser": "vitest --config vitest.config.browser.mjs",
    "build": "tshy",
    "dev": "tshy --watch",
    "clean": "rimraf node_modules .tshy .tshy-build dist .turbo"
  },
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@jimp/config-eslint": "workspace:*",
    "@jimp/config-typescript": "workspace:*",
    "@jimp/config-vitest": "workspace:*",
    "@jimp/core": "workspace:*",
    "@jimp/plugin-color": "workspace:*",
    "@jimp/test-utils": "workspace:*",
    "@jimp/types": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/browser": "^5.1.1",
    "eslint": "^10.15.0",
    "tshy": "~4.0.0",
    "typescript": "^7.0.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.1.1"
  },
  "tshy": {
    "exclude": [
      "**/*.test.ts"
    ],
    "dialects": [
      "esm"
    ],
    "esmDialects": [
      "browser"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "buffer": "^6.0.3",
    "zod": "^4.6.7"
  },
  "module": "./dist/esm/index.js"
}
