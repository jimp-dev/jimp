{
  "name": "@jimp/test-utils",
  "version": "2.0.0",
  "files": [
    "dist",
    "images"
  ],
  "repository": "jimp-dev/jimp",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "tshy",
    "dev": "tshy --watch",
    "clean": "rimraf node_modules .tshy .tshy-build dist .turbo"
  },
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jimp/types": "workspace:*",
    "buffer": "^6.0.3",
    "jest-image-snapshot": "^6.5.2"
  },
  "devDependencies": {
    "@jimp/config-eslint": "workspace:*",
    "@jimp/config-typescript": "workspace:*",
    "@types/jest-image-snapshot": "^6.4.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "tshy": "~4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "tshy": {
    "exclude": [
      "**/*.test.ts"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts",
      "./image-snapshot": "./src/image-snapshot.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./image-snapshot": {
      "import": {
        "types": "./dist/esm/image-snapshot.d.ts",
        "default": "./dist/esm/image-snapshot.js"
      },
      "require": {
        "types": "./dist/commonjs/image-snapshot.d.ts",
        "default": "./dist/commonjs/image-snapshot.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "module": "./dist/esm/index.js"
}
