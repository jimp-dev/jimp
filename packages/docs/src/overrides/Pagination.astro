---

const { prev, next } = Astro.locals.starlightRoute.pagination;
---

{
  (prev || next) && (
    <nav class="pager" aria-label="Pagination">
      {prev && (
        <a href={prev.href} rel="prev">
          <small>← {Astro.locals.t("page.previousLink")}</small>
          {prev.label}
        </a>
      )}
      {next && (
        <a href={next.href} rel="next">
          <small>{Astro.locals.t("page.nextLink")} →</small>
          {next.label}
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--jp-text);
    background: var(--jp-surface);
    border: 3.5px solid var(--jp-line);
    border-radius: 18px;
    padding: 10px 18px;
    box-shadow: 0 5px 0 var(--jp-shadow);
    font-family: var(--jp-ui);
    font-weight: 600;
    font-size: 19px;
    line-height: 1.3;
    overflow-wrap: anywhere;
    transition: transform 0.12s;
  }
  .pager a small {
    font-weight: 500;
    font-size: 13.5px;
    color: var(--jp-text-2);
  }
  .pager a:hover {
    transform: translateY(-3px);
    color: var(--jp-text);
    background: var(--jp-hover);
  }
  .pager a:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--jp-shadow);
  }
  .pager [rel="next"] {
    grid-column: 2;
    text-align: end;
  }
  @media (max-width: 49.99rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager [rel="next"] {
      grid-column: auto;
    }
  }
</style>
