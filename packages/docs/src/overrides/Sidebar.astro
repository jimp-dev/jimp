---
/**
 * Sidebar with sticker group labels. Top-level groups get a colored sticker,
 * nested groups a small heading, and collapsed groups (the generated type
 * reference) a disclosure. Link attrs from src/sidebar.ts:
 * `data-dot` adds a colored dot, `data-code` uses the code font.
 */
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarList from "../components/SidebarList.astro";

type Entry = StarlightRouteData["sidebar"][number];

const { sidebar } = Astro.locals.starlightRoute;
const hasCurrent = (entry: Entry): boolean =>
  entry.type === "link" ? entry.isCurrent : entry.entries.some(hasCurrent);
const stickerColors = ["var(--jp-red)", "var(--jp-sky)", "var(--jp-mint)", "#c9a8ff"];
const stickerTilt = [-1.5, 1.2, -1, 1.5];
---

{/* Starlight's persister restores the sidebar's scroll from the last page,
    so it stays put when you move between pages. */}
<SidebarPersister>
  <div class="sidebar-groups">
    {
      sidebar.map((entry, index) =>
        entry.type === "link" ? (
          <SidebarList entries={[entry]} />
        ) : entry.collapsed && !hasCurrent(entry) ? (
          <details class="grp">
            <summary
              class="lbl"
              style={`--c:${stickerColors[index % 4]}; --tilt:${stickerTilt[index % 4]}deg`}
            >
              {entry.label}
            </summary>
            <SidebarList entries={entry.entries} />
          </details>
        ) : (
          <div class="grp">
            <div
              class="lbl"
              style={`--c:${stickerColors[index % 4]}; --tilt:${stickerTilt[index % 4]}deg`}
            >
              {entry.label}
            </div>
            <SidebarList entries={entry.entries} />
          </div>
        ),
      )
    }
  </div>
</SidebarPersister>

<script is:inline>
  // Bring the current page's link into view when the sidebar scrolls, unless
  // the restored scroll position already shows it.
  (() => {
    const pane = document.getElementById("starlight__sidebar");
    const current = pane?.querySelector('[aria-current="page"]');
    if (!pane || !current) return;
    const top = current.offsetTop;
    const shown = top >= pane.scrollTop && top + current.offsetHeight <= pane.scrollTop + pane.clientHeight;
    if (!shown) pane.scrollTop = Math.max(0, top - pane.clientHeight / 2);
  })();
</script>

<style>
  .grp {
    margin: 0 0 16px;
  }
  .grp:last-child {
    margin-bottom: 4px;
  }
  .lbl {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--jp-ui);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--jp-ink);
    background: var(--c);
    border: 2.5px solid var(--jp-ink);
    border-radius: 10px 10px 10px 3px;
    padding: 1px 10px;
    box-shadow: 2px 3px 0 var(--jp-ink);
    transform: rotate(var(--tilt));
    margin: 0 0 8px 4px;
  }
  details > summary.lbl {
    cursor: pointer;
    list-style: none;
  }
  details > summary.lbl::-webkit-details-marker {
    display: none;
  }
  details > summary.lbl::after {
    content: "▸";
    font-size: 12px;
    transition: transform 0.15s;
  }
  details[open] > summary.lbl::after {
    transform: rotate(90deg);
  }
</style>
