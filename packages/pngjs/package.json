{
  "name": "@jimp/pngjs",
  "version": "2.0.0",
  "description": "PNG encoder and decoder in pure JavaScript, for Node.js and browsers. A maintained fork of pngjs.",
  "files": [
    "dist"
  ],
  "repository": "jimp-dev/jimp",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "test:browser": "vitest --config vitest.config.browser.mjs",
    "build": "tshy",
    "dev": "tshy --watch",
    "bench": "node bench/bench.mjs",
    "clean": "rimraf node_modules .tshy .tshy-build dist .turbo"
  },
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "contributors": [
    "Luke Page",
    "Kuba Niegowski",
    "Alexandre Paré",
    "Gaurav Mali",
    "Gusts Kaksis",
    "Pietajan De Potter",
    "Steven Sojka",
    "liangzeng",
    "Michael Vogt",
    "Xin-Xin Wang",
    "toriningen",
    "Eugene Kulabuhov"
  ],
  "license": "MIT",
  "keywords": [
    "png",
    "pngjs",
    "decoder",
    "encoder",
    "image"
  ],
  "dependencies": {
    "pako": "^3.0.3"
  },
  "devDependencies": {
    "@jimp/config-eslint": "workspace:*",
    "@jimp/config-typescript": "workspace:*",
    "@jimp/config-vitest": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@vitest/browser": "^5.1.1",
    "eslint": "^10.15.0",
    "pngjs": "^7.0.0",
    "tshy": "~4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "tshy": {
    "exclude": [
      "**/*.test.ts"
    ],
    "esmDialects": [
      "browser"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "module": "./dist/esm/index.js"
}
