{
  "name": "@jimp/jpeg-js",
  "version": "2.2.0",
  "description": "JPEG encoder and decoder in pure JavaScript, for Node.js and browsers. A maintained fork of jpeg-js.",
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE",
    "README.ijg"
  ],
  "repository": "jimp-dev/jimp",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "test:browser": "vitest --config vitest.config.browser.mjs",
    "build": "tshy",
    "dev": "tshy --watch",
    "clean": "rimraf node_modules .tshy .tshy-build dist .turbo"
  },
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "contributors": [
    "Eugene Ware <eugene@noblesamurai.com>",
    "Yury Delendik (notmasteryet)",
    "Mozilla Foundation (pdf.js)",
    "Adobe Systems Incorporated (as3corelib)",
    "Andreas Ritter (www.bytestrom.eu)",
    "Michael Kelly",
    "Peter Liljenberg",
    "XadillaX",
    "strandedcity",
    "wmossman",
    "Patrick Hulce",
    "Ben Wiley"
  ],
  "license": "BSD-3-Clause AND Apache-2.0 AND IJG",
  "keywords": [
    "jpeg",
    "jpg",
    "jpeg-js",
    "decoder",
    "encoder",
    "codec",
    "image"
  ],
  "devDependencies": {
    "@jimp/config-eslint": "workspace:*",
    "@jimp/config-typescript": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "eslint": "^10.15.0",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.65.1",
    "tshy": "~4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "tshy": {
    "exclude": [
      "**/*.test.ts",
      "test/**"
    ],
    "esmDialects": [
      "browser"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "module": "./dist/esm/index.js"
}
