{
  "name": "@jimp/server",
  "version": "2.0.0",
  "description": "Resize, crop and convert images on request, from URL params. Runs on Cloudflare Workers, Vercel Edge, Deno, Bun and Node.js.",
  "files": [
    "dist"
  ],
  "repository": "jimp-dev/jimp",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "build": "tshy",
    "dev": "tshy --watch",
    "clean": "rimraf node_modules .tshy .tshy-build dist .turbo"
  },
  "keywords": [
    "image",
    "image server",
    "image cdn",
    "resize",
    "thumbnail",
    "cloudflare workers",
    "edge"
  ],
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jimp/utils": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jimp/config-eslint": "workspace:*",
    "@jimp/config-typescript": "workspace:*",
    "@jimp/core": "workspace:*",
    "@jimp/test-utils": "workspace:*",
    "@jimp/wasm-avif": "workspace:*",
    "@jimp/wasm-webp": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "jimp": "workspace:*",
    "tshy": "~4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "tshy": {
    "exclude": [
      "**/*.test.ts"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts",
      "./node": "./src/node.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/commonjs/node.d.ts",
        "default": "./dist/commonjs/node.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "module": "./dist/esm/index.js"
}
